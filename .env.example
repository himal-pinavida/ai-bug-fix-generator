# Copy to .env and adjust. Placeholder values only; NEVER commit real secrets.

# HTTP port the API binds.
PORT=3001

# REQUIRED for live AI fixes. When missing the API starts in degraded mode:
# /health returns 503 unhealthy and POST /api/fix returns 503 AI_PROVIDER_UNAVAILABLE.
OPENAI_API_KEY=replace-with-your-api-key

# Optional provider configuration.
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Default 25000ms; values above 29000ms are capped so total API latency stays under 30s.
AI_PROVIDER_TIMEOUT_MS=25000

# Comma-separated browser origins allowed by CORS. Use * for all origins.
CORS_ORIGINS=*
